{
  // Cloudflare Workers config. The site is fully static: Workers serves the
  // files in ./dist directly (no Worker script, so requests are free).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matthepburn",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
