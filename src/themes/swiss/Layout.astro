---
import '../../styles/base.css';
import './theme.css';
import Seo, { type SeoProps } from '../../components/Seo.astro';
import { LINKS, NAV, SITE } from '../../site';

type Props = SeoProps;

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
        {SITE.name}
      </a>
      <nav aria-label="Main">
        <ol>
          {
            NAV.map((item, i) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="grid">
        <p class="footer-name">{SITE.name}</p>
        <ul class="footer-links">
          {
            LINKS.map((link) => (
              <li>
                <a class="arrow-link" href={link.href}>
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="copyright">© {year}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
  }

  nav ol {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-block: 0.4rem;
    font-weight: 500;
    text-decoration: none;
  }

  .num {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page'] .num {
    color: var(--accent);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-bottom: 2.5rem;
  }

  .site-footer .grid {
    align-items: end;
    row-gap: 1rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--fg);
  }

  .footer-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .copyright {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (min-width: 56rem) {
    .footer-name {
      grid-column: 1 / span 6;
    }

    .footer-links {
      grid-column: 7 / span 4;
    }

    .copyright {
      grid-column: 11 / -1;
      text-align: right;
    }
  }
</style>
