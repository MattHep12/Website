---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from './Layout.astro';
import DemoEmbed from '../../components/DemoEmbed.astro';
import { isExternal, type Project } from '../../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tags, cover, coverAlt, github, demo, embed, embedHeight, date } =
  project.data;
const { Content } = await render(project);

const links = [
  demo && { label: 'Live demo', href: demo },
  github && { label: 'Source code', href: github },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout title={title} description={description} image={cover} imageAlt={coverAlt} type="article">
  <article>
    <header class="wrap head">
      <a class="eyebrow back" href="/projects/">← All projects</a>
      <h1>{title}</h1>
      <div class="grid intro">
        <p class="eyebrow col-label">Project · {date.getUTCFullYear()}</p>
        <p class="lede col-text">{description}</p>
      </div>
    </header>

    {
      embed && demo ? (
        <div class="wrap media">
          <DemoEmbed src={demo} title={title} height={embedHeight} />
        </div>
      ) : (
        cover && (
          <figure class="wrap media cover">
            <Picture
              src={cover}
              alt={coverAlt ?? ''}
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 90rem) 84rem, calc(100vw - 2.5rem)"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )
      )
    }

    <div class="wrap grid body">
      <aside class="col-label meta" aria-label="Project details">
        <dl>
          <div>
            <dt class="eyebrow">Year</dt>
            <dd><time datetime={date.toISOString()}>{date.getUTCFullYear()}</time></dd>
          </div>
          {
            tags.length > 0 && (
              <div>
                <dt class="eyebrow">Stack</dt>
                <dd>
                  <ul class="stack">
                    {tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            links.length > 0 && (
              <div>
                <dt class="eyebrow">Links</dt>
                <dd>
                  <ul class="stack">
                    {links.map((link) => (
                      <li>
                        <a class="arrow-link" href={link.href}>
                          {link.label}
                          <span aria-hidden="true">{isExternal(link.href) ? '↗' : '→'}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
      <div class="col-main prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .head {
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }

  .back {
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin: 1rem 0 0;
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .intro {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 2px solid var(--fg);
    row-gap: 0.75rem;
  }

  .lede {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .media {
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .body {
    row-gap: 2.5rem;
  }

  .meta dl {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .meta dl {
      position: sticky;
      top: 2rem;
    }
  }

  .meta dd {
    margin: 0.35rem 0 0;
  }

  .stack {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack a {
    color: var(--accent);
  }
</style>
