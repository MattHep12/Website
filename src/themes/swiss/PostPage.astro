---
import { render } from 'astro:content';
import Layout from './Layout.astro';
import { formatDate, type Post } from '../../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, tags } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description} type="article" publishedTime={date}>
  <article class="wrap">
    <header class="head">
      <a class="eyebrow back" href="/misc/">← Misc</a>
      <h1>{title}</h1>
    </header>
    <div class="grid body">
      <aside class="col-label meta" aria-label="Post details">
        <dl>
          <div>
            <dt class="eyebrow">Published</dt>
            <dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
          </div>
          {
            updated && (
              <div>
                <dt class="eyebrow">Updated</dt>
                <dd>
                  <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                </dd>
              </div>
            )
          }
          {
            tags.length > 0 && (
              <div>
                <dt class="eyebrow">Tags</dt>
                <dd>
                  <ul class="tags">
                    {tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
      <div class="col-main prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .head {
    padding-top: clamp(2rem, 6vw, 4.5rem);
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--fg);
    margin-bottom: 2rem;
  }

  .back {
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin: 1rem 0 0;
    max-width: 18ch;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .body {
    row-gap: 2rem;
  }

  .meta dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .meta dl {
      position: sticky;
      top: 2rem;
      flex-direction: column;
    }
  }

  .meta dd {
    margin: 0.35rem 0 0;
  }
</style>
