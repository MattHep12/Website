---
import { Picture } from 'astro:assets';
import { isExternal, projectHref, projectLinks, type Project } from '../../lib/content';

interface Props {
  project: Project;
  index: number;
  headingLevel?: 2 | 3;
}

const { project, index, headingLevel = 3 } = Astro.props;
const { title, description, tags, cover, coverAlt, date } = project.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const href = projectHref(project);
const extra = projectLinks(project);
const number = String(index + 1).padStart(2, '0');
// Alternate wide/narrow tiles: 7+5, then 5+7, and so on.
const wide = index % 4 === 0 || index % 4 === 3;
---

<article class:list={['tile', wide ? 'wide' : 'narrow']}>
  <div class="media">
    {
      cover ? (
        <Picture
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 800, 1200, 1600]}
          sizes={
            wide
              ? '(min-width: 56rem) 58vw, calc(100vw - 2.5rem)'
              : '(min-width: 56rem) 40vw, calc(100vw - 2.5rem)'
          }
          formats={['avif', 'webp']}
        />
      ) : (
        <span class="placeholder" aria-hidden="true">
          {number}
        </span>
      )
    }
  </div>

  <div class="info">
    <span class="num" aria-hidden="true">{number}</span>
    <div class="text">
      <H class="title">
        {
          href ? (
            <a class="stretched" href={href}>
              {title}
              <span class="arrow" aria-hidden="true">
                {isExternal(href) ? '↗' : '→'}
              </span>
            </a>
          ) : (
            title
          )
        }
      </H>
      <p class="desc">{description}</p>
      <div class="foot">
        {
          tags.length > 0 && (
            <ul class="tags" aria-label="Technologies">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        <time class="year" datetime={date.toISOString()}>{date.getUTCFullYear()}</time>
      </div>
      {
        extra.length > 0 && (
          <ul class="links">
            {extra.map((link) => (
              <li>
                <a class="arrow-link" href={link.href}>
                  {link.label} <span class="sr-only">for {title}</span>
                  <span aria-hidden="true">{isExternal(link.href) ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .tile {
    position: relative;
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  @media (min-width: 56rem) {
    .wide {
      grid-column: span 7;
    }

    .narrow {
      grid-column: span 5;
    }
  }

  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
  }

  .wide .media {
    aspect-ratio: 16 / 11;
  }

  @media (min-width: 56rem) {
    .narrow .media {
      aspect-ratio: 1 / 1;
    }
  }

  .media :global(picture) {
    display: contents;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Screenshots usually matter most at the top left, so crop from there. */
    object-position: left top;
    transform-origin: left top;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .tile:hover .media :global(img),
  .tile:focus-within .media :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 11rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .info {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
  }

  .num {
    padding-top: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .title a {
    text-decoration: none;
  }

  /* Make the whole tile clickable via the title link. */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stretched:focus-visible {
    outline: none;
  }

  .tile:has(.stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--accent);
    transition: transform 0.2s;
  }

  .tile:hover .arrow {
    transform: translateX(4px);
  }

  .tile:hover .title a {
    color: var(--accent);
  }

  .desc {
    margin: 0.5rem 0 0;
    max-width: 34rem;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .year {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .links {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }
</style>
