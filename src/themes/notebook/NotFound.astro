---
import Layout from './Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap">
    <p class="label">Error 404</p>
    <h1>This page wandered off.</h1>
    <p class="lede measure">
      The link may be old, or the page may have moved. Try the <a href="/">home page</a>, the
      <a href="/projects/">projects</a>, or the <a href="/misc/">misc</a> notes.
    </p>
  </div>
</Layout>

<style>
  .wrap {
    padding-block: 3rem;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lede {
    font-size: 1.25rem;
  }

  .lede a {
    color: var(--accent);
  }
</style>
