---
import { Picture } from 'astro:assets';
import { isExternal, projectHref, projectLinks, type Project } from '../../lib/content';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { title, description, tags, cover, coverAlt, date } = project.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const href = projectHref(project);
const extra = projectLinks(project);
---

<article class="project">
  <div class="thumb" aria-hidden={cover ? undefined : 'true'}>
    {
      cover ? (
        <Picture
          src={cover}
          alt={coverAlt ?? ''}
          widths={[320, 640, 960]}
          sizes="(min-width: 40rem) 13rem, calc(100vw - 2.5rem)"
          formats={['avif', 'webp']}
        />
      ) : (
        <span class="initial">{title.charAt(0)}</span>
      )
    }
  </div>
  <div class="body">
    <p class="label"><time datetime={date.toISOString()}>{date.getUTCFullYear()}</time></p>
    <H class="title">
      {
        href ? (
          <a href={href}>
            {title}
            {isExternal(href) && <span aria-hidden="true"> ↗</span>}
          </a>
        ) : (
          title
        )
      }
    </H>
    <p class="desc">{description}</p>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Technologies">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {
      extra.length > 0 && (
        <ul class="links">
          {extra.map((link) => (
            <li>
              <a href={link.href}>
                {link.label} <span class="sr-only">for {title}</span>
                <span aria-hidden="true">{isExternal(link.href) ? '↗' : '→'}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1.75rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--accent-soft);
  }

  .thumb :global(picture) {
    display: contents;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    display: block;
  }

  .initial {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 4rem;
    font-style: italic;
    color: var(--accent);
    line-height: 1;
  }

  .body > * {
    margin: 0;
  }

  .title {
    margin-top: 0.15rem;
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .desc {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .tags {
    margin-top: 0.8rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.8rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .links a {
    color: var(--accent);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .project {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .thumb {
      aspect-ratio: 16 / 9;
    }
  }
</style>
