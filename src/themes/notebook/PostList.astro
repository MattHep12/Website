---
import { formatDate, type Post } from '../../lib/content';

interface Props {
  posts: Post[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <time class="label" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div>
          <H class="title">
            <a href={`/misc/${post.id}/`}>{post.data.title}</a>
          </H>
          <p class="desc">{post.data.description}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.25rem 1.75rem;
    padding-block: 1rem;
    border-bottom: 1px dashed var(--border);
  }

  time {
    padding-top: 0.45rem;
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .desc {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
    }

    time {
      padding-top: 0;
    }
  }
</style>
